# Rate Provider Configuration
# Set to 'chennai' (default) to manage Chennai daily rates via /admin/rates
GOLD_RATE_PROVIDER=chennai

# Admin PIN for updating daily Chennai gold rates at /admin/rates
# Change this to your private passcode
ADMIN_RATE_PIN=1234

# How long upstream/cached responses are kept (in seconds)
GOLD_RATE_CACHE_SECONDS=60

# Maximum age before rates are marked as stale (in minutes, 2160 = 36 hours)
GOLD_RATE_STALE_AFTER_MINUTES=2160

# Optional: GoldAPI.io configuration (if using international spot rates instead)
# GOLD_RATE_PROVIDER=goldapi
# GOLD_RATE_API_KEY=your_goldapi_key_here

# Business Details
# NEXT_PUBLIC_BUSINESS_PHONE=+91XXXXXXXXXX
# NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
# NEXT_PUBLIC_BUSINESS_EMAIL=info@edwingold.com
# NEXT_PUBLIC_SITE_URL=https://edwingold.com

