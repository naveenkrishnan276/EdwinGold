# ==============================================================================
# EDWIN GOLD — Environment Variables & Vercel Deployment Configuration
# ==============================================================================

# Admin Passcode PIN for /admin/rates and /admin
# Change this to your secret numeric or alphanumeric PIN
ADMIN_RATE_PIN=1234

# Rate Provider: 'chennai' (default, owner-managed daily rates) or 'goldapi'
GOLD_RATE_PROVIDER=chennai

# Serverless Persistence (Vercel KV or Upstash Redis)
# Highly recommended for Vercel deployment so prices and branch updates persist
# across all serverless lambdas. Upstash Redis has a 100% free tier.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=xxxx
# or
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# Cache & Freshness Settings
GOLD_RATE_CACHE_SECONDS=60
GOLD_RATE_STALE_AFTER_MINUTES=2160

# Optional Upstream Spot API (only needed if GOLD_RATE_PROVIDER=goldapi)
# GOLD_RATE_API_KEY=your_goldapi_key_here

# Public Contact Details (Optional overrides - can also be edited via /admin)
# NEXT_PUBLIC_BUSINESS_PHONE=+91XXXXXXXXXX
# NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
# NEXT_PUBLIC_BUSINESS_EMAIL=info@edwingold.com
# NEXT_PUBLIC_SITE_URL=https://edwingold.com
